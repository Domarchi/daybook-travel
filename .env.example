NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Avisos diarios de viajes por comprar (solo servidor; nunca con NEXT_PUBLIC_).
# Se ponen en Vercel (Settings → Environment Variables), no en el repositorio.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
RESEND_API_KEY=
# "Daybook Travel <avisos@tu-dominio>": el dominio tiene que estar verificado en Resend.
ALERT_FROM=
# Correos separados por coma.
ALERT_RECIPIENTS=

# Bita, la asistente (solo servidor; nunca con NEXT_PUBLIC_). Viene apagada.
# Ver docs/bita.md. SUPABASE_SERVICE_ROLE_KEY (arriba) solo cuenta sus mensajes.
BITA_ENABLED=
ANTHROPIC_API_KEY=
# Opcionales: modelo (por omisión claude-haiku-5-5) y mensajes por persona al día (20).
BITA_MODEL=
BITA_DAILY_LIMIT=
